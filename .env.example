APP_NAME=Labora Backend
APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1

JWT_SECRET_KEY=change-this-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_HASH_ALGORITHM=bcrypt
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
APP_FRONTEND_URL=http://localhost:3000
EMAIL_PROVIDER=smtp
EMAIL_FROM="Labora <tu_correo@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=replace_with_gmail_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

DATABASE_URL=postgresql+psycopg://labora:labora_password@labora-postgres:5432/labora_db

POSTGRES_DB=labora_db
POSTGRES_USER=labora
POSTGRES_PASSWORD=labora_password
POSTGRES_HOST=labora-postgres
POSTGRES_PORT=5432

CORS_ORIGINS=http://localhost:3000,https://labora.centralspike.com
CORS_ALLOW_CREDENTIALS=true

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
API_PUBLIC_BASE_URL=
PUBLIC_API_URL=

AUTH_COOKIE_NAME=labora_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTPONLY=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=

GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile

OAUTH_STATE_EXPIRE_MINUTES=10

LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=25
STORAGE_BACKEND=minio
MINIO_ENDPOINT=labora-minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=labora_minio
MINIO_SECRET_KEY=labora_minio_password
MINIO_BUCKET=documents
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PRESIGNED_UPLOAD_TTL_SECONDS=900

AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_TEMPERATURE=0
AI_JSON_MODE=true

AI_EXTRACTION_PROVIDER=mock
AI_EXTRACTION_MODEL=
AI_EXTRACTION_API_KEY=
AI_EXTRACTION_BASE_URL=
AI_EXTRACTION_TIMEOUT_MS=60000
AI_EXTRACTION_CONFIDENCE_LOW=0.65
AI_EXTRACTION_CONFIDENCE_BLOCKING=0.50

EXTRACTION_JOB_MAX_RETRIES=3
EXTRACTION_JOB_TIMEOUT_MS=180000
EXTRACTION_ENABLE_REPROCESS=true
EXTRACTION_PRESERVE_USER_CORRECTIONS=true

AI_PRE_ANALYSIS_PROVIDER=mock
AI_PRE_ANALYSIS_MODEL=
AI_PRE_ANALYSIS_API_KEY=
AI_PRE_ANALYSIS_BASE_URL=
AI_PRE_ANALYSIS_TIMEOUT_MS=60000
PRE_ANALYSIS_JOB_MAX_ATTEMPTS=3

EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_P_KEY=
EPAYCO_API_BASE_URL=https://apify.epayco.co
EPAYCO_CHECKOUT_VERSION=2
EPAYCO_CHECKOUT_TYPE=onpage
EPAYCO_TEST_MODE=true
EPAYCO_COMMERCE_NAME=Labora
EPAYCO_CHECKOUT_TIMEOUT_MS=15000
EPAYCO_CONFIRMATION_URL=

PAYMENT_PROVIDER=epayco
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_ORDER_EXPIRATION_MINUTES=60
PAYMENT_CURRENCY=COP
FULL_ANALYSIS_UNLOCK_PRICE_COP=150000
PAYMENT_WEBHOOK_RATE_LIMIT_PER_MINUTE=60

# Production example:
# API_PUBLIC_BASE_URL=https://labora.backend.centralspike.com
# BACKEND_PUBLIC_URL=https://labora.backend.centralspike.com
# CORS_ORIGINS=https://labora.centralspike.com,http://localhost:3000
# MINIO_ENDPOINT=http://labora-minio:9000
# MINIO_PUBLIC_ENDPOINT=https://minio.centralspike.com
